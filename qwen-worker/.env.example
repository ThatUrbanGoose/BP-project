QWEN_WORKER_HOST=127.0.0.1
QWEN_WORKER_PORT=3003

BP_DATA_DIRECTORY=D:\BP-Local
BP_MODEL_DIRECTORY=D:\BP-Local\models
BP_AUDIO_CACHE_DIRECTORY=D:\BP-Local\audio-cache
BP_METADATA_DIRECTORY=D:\BP-Local\metadata

HF_HOME=D:\BP-Local\models\huggingface
HUGGINGFACE_HUB_CACHE=D:\BP-Local\models\huggingface\hub
TORCH_HOME=D:\BP-Local\models\torch

QWEN_MODEL_DIRECTORY=D:\BP-Local\models\qwen3-tts
QWEN_AUDIO_DIRECTORY=D:\BP-Local\audio-cache\qwen3-tts
QWEN_METADATA_DIRECTORY=D:\BP-Local\metadata\qwen3-tts

QWEN_DEFAULT_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_DEVICE=auto
QWEN_MAX_TEXT_LENGTH=1000
QWEN_MAX_CONCURRENT_JOBS=1
QWEN_MIN_AVAILABLE_RAM_GB=6
QWEN_MIN_AVAILABLE_VRAM_GB=4.7
HF_HUB_DISABLE_SYMLINKS_WARNING=1

QWEN_DEFAULT_SPEAKER=Aiden
QWEN_DEFAULT_LANGUAGE=English
QWEN_TEST_INSTRUCTION=Speak calmly and clearly, with controlled warmth and a measured pace.
QWEN_ATTENTION_IMPLEMENTATION=sdpa

QWEN_IDLE_TIMEOUT_SECONDS=300